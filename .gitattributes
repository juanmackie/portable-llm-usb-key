# Everything here runs on Windows, from a clone. Pin the line endings so a clone on
# any platform produces files cmd.exe and wscript.exe accept.
* text=auto eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.txt  text eol=crlf
*.ini  text eol=crlf
*.md   text eol=lf
*.png  binary
*.jpg  binary
*.inf  text eol=crlf
